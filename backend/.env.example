PORT=5000
MONGO_URI=mongodb://localhost:27017/intellitwin
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN_DAYS=7
CLIENT_ORIGIN=http://localhost:3000

# ---- Generation: Llama 3.2 running locally through Ollama ----
# Ollama exposes an OpenAI-compatible API, so the backend talks to it with the
# OpenAI client. Setup:  ollama pull llama3.2   (then `ollama serve` if it isn't already running)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.3

# ---- Embeddings (independent from generation) ----
# Leave OPENAI_API_KEY empty to use the built-in offline embedding.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

# ---- Atlas web search (optional) ----
TAVILY_API_KEY=

# ---- Standalone Echo MCP server (optional) ----
ECHO_MCP_USER_EMAIL=

# Compass AI "Next up" suggestions (generated by the LLM above from your stored
# tasks/goals/events, cached per user, always labelled "AI" in the UI).
AI_SUGGESTIONS_ENABLED=true
AI_SUGGESTIONS_TIMEOUT_SECONDS=90
AI_SUGGESTIONS_FAILURE_COOLDOWN_SECONDS=600
